DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Dedicated host port; Workshop uses 8000.
ACADEMY_PORT=8080

# Password recovery (use provider-specific SMTP credentials; never commit secrets).
ACADEMY_PUBLIC_URL=http://127.0.0.1:8080
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Practical AI <noreply@your-verified-domain.example>
PASSWORD_RESET_TIMEOUT=3600
# Port 465: EMAIL_USE_SSL=1 and EMAIL_USE_TLS=0.
